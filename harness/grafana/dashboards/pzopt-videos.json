  {
   "type": "trend",
   "title": "Frame time on the video's clock (x = seconds since launch)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pzopt-pg"
   },
   "description": "Every game frame (pzopt-frames.out) and every presented frame (pzopt-overlay.out) of the picked run, x = seconds into the recording, so a spike here is the moment to scrub to in the player.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pzopt-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "WITH r AS (SELECT started FROM runs WHERE run = ${vrun:sqlstring})\nSELECT video_s, \"game frame\", presented FROM (\n  SELECT extract(epoch from f.t - r.started) AS video_s, f.ms AS \"game frame\", NULL::real AS presented\n  FROM frames f, r WHERE f.run = ${vrun:sqlstring}\n  UNION ALL SELECT extract(epoch from o.t - r.started), NULL, o.ms FROM overlay o, r WHERE o.run = ${vrun:sqlstring}) x\nORDER BY 1",
     "hide": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "showPoints": "never",
      "fillOpacity": 8,
      "axisSoftMin": 0,
      "thresholdsStyle": {
       "mode": "dashed"
      },
      "spanNulls": true
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "red",
        "value": 16.7
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "video_s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     }
