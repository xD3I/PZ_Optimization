     "rawSql": "SELECT coalesce(verdict, '-') AS \"Jev\", coalesce(CASE WHEN preset = 'louisville' THEN CASE WHEN (SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks') IS NULL THEN 'no counters'\n  WHEN (SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks') > 50000 THEN 'FLOODED' ELSE 'healthy' END END, '-') AS \"bake check\",\n  coalesce(round((SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks'))::text, '-') AS strongMarks FROM runs LEFT JOIN run_videos v USING (run) WHERE run = ${vrun:sqlstring}",
