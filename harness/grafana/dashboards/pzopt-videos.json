  {
   "type": "stat",
   "title": "Louisville bake check",
   "description": "Recorded --preset louisville runs by bake_counters strongMarks (pzopt-bench.out): a healthy 25 s route has \u2248 14k, the see_all NaN flood 90k-350k; above 50k counts as flooded. A flooded run is discarded and re-run; the frames of its settle window show the pale roof blotches.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pzopt-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pzopt-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT count(*) FILTER (WHERE sm <= 50000) AS healthy,\n  count(*) FILTER (WHERE sm > 50000) AS flooded, count(*) FILTER (WHERE sm IS NULL) AS \"no counters\"\nFROM (SELECT (SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks') AS sm FROM runs LEFT JOIN run_videos v USING (run) WHERE (opts->>'record' = '1' OR v.run IS NOT NULL) AND $__timeFilter(started) AND machine IN (${machine:sqlstring}) AND coalesce(preset, 'none') IN (${preset:sqlstring}) AND label ~ ${label:sqlstring} AND preset = 'louisville') x",
     "hide": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
