     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT started, run, CASE WHEN v.url IS NOT NULL THEN 'watch' END AS video, v.url AS video_url,\n  CASE WHEN v.url IS NOT NULL THEN 'bucket' ELSE 'not uploaded' END AS \"where\", v.bytes AS size,\n  round(extract(epoch from route_start - started)::numeric, 1) AS \"route at s\", round(route_seconds::numeric) AS \"route s\",\n  CASE WHEN preset = 'louisville' THEN CASE WHEN (SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks') IS NULL THEN 'no counters'\n  WHEN (SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks') > 50000 THEN 'FLOODED' ELSE 'healthy' END END AS \"bake check\", (SELECT max(value) FROM counters c WHERE c.run = runs.run AND c.grp = 'bake_counters' AND c.key = 'strongMarks') AS strongMarks, fps_mean AS fps, p99_ms AS p99, p99_9_ms AS \"p99.9\",\n  gpu_pct AS \"GPU %\", busiest_core_pct AS \"busiest core %\", verdict, valid, opts->>'record_audio' AS audio,\n  machine, mode, preset, variant, label\nFROM runs LEFT JOIN run_videos v USING (run) WHERE (opts->>'record' = '1' OR v.run IS NOT NULL) AND $__timeFilter(started) AND machine IN (${machine:sqlstring}) AND coalesce(preset, 'none') IN (${preset:sqlstring}) AND label ~ ${label:sqlstring} ORDER BY started DESC",
     "hide": false
    }
   ],
