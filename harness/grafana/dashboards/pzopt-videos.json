     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT date_trunc('day', started) AS time, machine AS metric, count(*) AS value\nFROM runs LEFT JOIN run_videos v USING (run) WHERE (opts->>'record' = '1' OR v.run IS NOT NULL) AND $__timeFilter(started) AND machine IN (${machine:sqlstring}) AND coalesce(preset, 'none') IN (${preset:sqlstring}) AND label ~ ${label:sqlstring} GROUP BY 1, 2 ORDER BY 1",
